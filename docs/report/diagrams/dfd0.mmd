flowchart LR
    classDef ent fill:#EEF2FF,stroke:#4338CA,color:#1E1B4B,stroke-width:1.5px
    classDef sys fill:#4338CA,stroke:#312E81,color:#FFFFFF,stroke-width:2px
    classDef ext fill:#FFF7ED,stroke:#C2410C,color:#431407,stroke-width:1.5px

    R["Researcher"]:::ent
    A["AI assistant<br/>(MCP client)"]:::ent
    S["Administrator"]:::ent
    SYS(("0<br/>IndexR<br/>system")):::sys
    P["Scholarly sources"]:::ext
    L["LLM and reranker<br/>providers"]:::ext

    R -- "questions, uploads,<br/>topics to track" --> SYS
    SYS -- "cited answers, papers,<br/>tracking updates" --> R
    A -- "tool calls<br/>(access token)" --> SYS
    SYS -- "passages, answers,<br/>updates" --> A
    S -- "corpus moderation" --> SYS
    SYS -- "search and citation<br/>queries" --> P
    P -- "metadata and PDFs" --> SYS
    SYS -- "prompts, passages" --> L
    L -- "expansions, scores,<br/>answers" --> SYS
