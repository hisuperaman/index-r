flowchart TD
    classDef step fill:#F8FAFC,stroke:#334155,color:#0F172A,stroke-width:1.5px
    classDef dec fill:#EEF2FF,stroke:#4338CA,color:#1E1B4B,stroke-width:1.5px
    classDef out fill:#ECFDF5,stroke:#047857,color:#064E3B,stroke-width:1.5px
    BEAT(["Celery beat: daily at 06:00 UTC"]):::out --> FAN["check_tracking: queue one task<br/>per topic and per tracked paper"]:::step
    FAN --> T1["Topic: discover papers published<br/>since the last check (first: 30 days)"]:::step
    T1 --> T2{"Already in the<br/>workspace?"}:::dec
    T2 -- "no" --> U1["Update: new paper on topic"]:::out
    FAN --> C1["Tracked paper: find its OpenAlex work<br/>(by DOI or arXiv DOI)"]:::step
    C1 --> C2["List the 10 newest citing papers<br/>since the last check"]:::step
    C2 --> C3{"Citation already<br/>known?"}:::dec
    C3 -- "no" --> U2["Store citation edge;<br/>update: new citation"]:::out
    FAN --> V1["arXiv id_list: latest revision date<br/>of every tracked arXiv paper"]:::step
    V1 --> V2{"Newer than the<br/>stored revision?"}:::dec
    V2 -- "yes" --> U3["Update: new version"]:::out
    U1 --> BAN["Workspace shows<br/>'N updates since date'"]:::out
    U2 --> BAN
    U3 --> BAN
