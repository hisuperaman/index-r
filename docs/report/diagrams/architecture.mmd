flowchart TB
    classDef client fill:#EEF2FF,stroke:#4338CA,color:#1E1B4B,stroke-width:1.5px
    classDef server fill:#F8FAFC,stroke:#334155,color:#0F172A,stroke-width:1.5px
    classDef store fill:#ECFDF5,stroke:#047857,color:#064E3B,stroke-width:1.5px
    classDef ext fill:#FFF7ED,stroke:#C2410C,color:#431407,stroke-width:1.5px

    WEB["React web app<br/>(Vite, shadcn/ui)"]:::client
    MCPC["AI assistants<br/>(MCP clients)"]:::client
    ADMIN["Django admin<br/>(staff users)"]:::client

    API["REST API + SSE<br/>iam · papers · workspaces · integrations"]:::server
    MCP["MCP server<br/>stdio / streamable HTTP"]:::server
    SVC["Service layer<br/>Ask · Retrieval · Discovery · Answer<br/>Rerank · Upload · Tracking"]:::server
    BEAT["Celery beat<br/>daily tracking · hourly requeue"]:::server
    WORKER["Celery worker<br/>ingestion · tracking checks"]:::server

    PG[("PostgreSQL<br/>papers · chunks (tsvector, GIN)<br/>workspaces · messages · updates")]:::store
    REDIS[("Redis<br/>task broker")]:::store

    SRC["Paper sources<br/>arXiv · OpenAlex · S2"]:::ext
    LLM["LLM provider<br/>(pydantic-ai)"]:::ext
    COH["Cohere Rerank<br/>v3.5"]:::ext

    WEB -- "HTTPS + JWT" --> API
    ADMIN --> API
    MCPC -- "Bearer token" --> MCP
    API --> SVC
    MCP --> SVC
    SVC --> PG
    SVC -- "queue" --> REDIS
    BEAT --> REDIS
    REDIS --> WORKER
    WORKER --> SVC
    SVC --> SRC
    SVC --> LLM
    SVC --> COH
