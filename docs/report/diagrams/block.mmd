flowchart TB
    classDef in fill:#EEF2FF,stroke:#4338CA,color:#1E1B4B,stroke-width:1.5px
    classDef proc fill:#F8FAFC,stroke:#334155,color:#0F172A,stroke-width:1.5px
    classDef out fill:#ECFDF5,stroke:#047857,color:#064E3B,stroke-width:1.5px
    subgraph R1["1 · Understand and retrieve"]
        direction LR
        Q["Research question<br/>(web app or MCP)"]:::in --> QE["Query expansion<br/>(LLM)"]:::proc --> FTS["Full-text search<br/>PostgreSQL tsvector"]:::proc --> BOOST["Metadata boost<br/>citations × recency"]:::proc
    end
    subgraph R2["2 · Check evidence, discover if needed"]
        direction LR
        RR["Cross-encoder rerank<br/>(Cohere)"]:::proc --> GATE{"Two-gate check:<br/>enough evidence?"}:::proc
        GATE -- "no" --> DISC["Discovery<br/>arXiv · OpenAlex · S2"]:::proc --> ING["Ingestion<br/>PDF → sections → chunks"]:::proc
    end
    subgraph R3["3 · Answer"]
        direction LR
        ANS["Grounded answer<br/>(numbered passages)"]:::proc --> CIT["Citation mapping<br/>[n] → paper · section · page"]:::proc --> OUT["Cited answer<br/>streamed to the user"]:::out
    end
    R1 --> R2 --> R3
