        U1(["Sign up / log in<br/>(email or Google)"]):::uc
        U2(["Create and manage workspaces"]):::uc
        U3(["Ask a question,<br/>get a cited answer"]):::uc
        U4(["Inspect a citation<br/>(section, page, text)"]):::uc
        U5(["Add, remove or upload papers"]):::uc
        U6(["Track topics and papers"]):::uc
        U7(["Review tracking updates"]):::uc
        U8(["Create / revoke access tokens"]):::uc
        U9(["Search papers via MCP tools"]):::uc
        U10(["Moderate papers, authors,<br/>workspaces"]):::uc
